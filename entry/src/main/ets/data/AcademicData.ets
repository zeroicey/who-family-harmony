export class AcademicRecord {
  day: string;
  building: string;
  period: string;
  rooms: number;
  students: number;

  constructor(day: string, building: string, period: string, rooms: number, students: number) {
    this.day = day;
    this.building = building;
    this.period = period;
    this.rooms = rooms;
    this.students = students;
  }
}

